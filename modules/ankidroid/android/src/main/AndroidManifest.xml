<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Runtime permission defined by AnkiDroid for its FlashCards ContentProvider -->
  <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

  <!-- Android 11+ package visibility: lets us see AnkiDroid and its provider -->
  <queries>
    <package android:name="com.ichi2.anki" />
    <provider android:authorities="com.ichi2.anki.flashcards" />
  </queries>
</manifest>
